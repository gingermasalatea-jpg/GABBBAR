# ───────────── Core ─────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS, OAuth redirects and cookies)
APP_URL=http://localhost:3000
# Public URL of the API server (Meta webhook + Google OAuth callback live here)
API_URL=http://localhost:4000

DATABASE_URL=postgres://wadesk:wadesk@localhost:5432/wadesk
REDIS_URL=redis://localhost:6379

# 64+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-change-me-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=12
# 32-byte key, base64. Encrypts Meta tokens, AI keys, Google tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Where incoming WhatsApp media is stored
MEDIA_DIR=./storage/media

# Run BullMQ workers in the same process as the API (true for local dev / small installs)
RUN_WORKERS=true

# ───────────── Mock / demo flags ─────────────
# true = never call the real service. Leave true until real credentials are added.
WHATSAPP_MOCK=true
AI_MOCK=true
GOOGLE_MOCK=true

# ───────────── WhatsApp Cloud API (optional here, can also be set in Settings UI) ─────────────
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=

# ───────────── AI providers (optional here, can also be set in Settings UI) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ───────────── Google Sheets OAuth ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────── Seed ─────────────
SEED_ADMIN_EMAIL=admin@wadesk.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# ───────────── Web (Next.js) ─────────────
# The web app proxies /api/* to this address.
API_INTERNAL_URL=http://localhost:4000
